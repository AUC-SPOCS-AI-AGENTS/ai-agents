# Copy this file to .env and fill in the values. Never commit .env.
OPENROUTER_API_KEY=
# Embedding model announced by the course team (OpenRouter model id)
EMBEDDING_MODEL=
# "No match" cut-off for search by meaning (chosen from real scores: 0.50)
MIN_SIMILARITY=
# Optional: chat model for the experts (default: openai/gpt-4o-mini)
CHAT_MODEL=
